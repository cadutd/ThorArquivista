{
  "name": "thor-pesquisador-frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e:imagens": "node tests/e2e/imagens.smoke.cjs",
    "test:e2e:registros-busca": "node tests/e2e/registros-busca.smoke.cjs",
    "test:e2e:editorial": "node tests/e2e/editorial.smoke.cjs",
    "test:functional": "node --test tests/functional/*.test.mjs",
    "test:functional:report": "node -e \"require('node:fs').mkdirSync('../test-reports/frontend', { recursive: true })\" && node --test --test-reporter=junit --test-reporter-destination=../test-reports/frontend/junit.xml tests/functional/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
