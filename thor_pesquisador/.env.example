# Development only. Use docker-compose.govbr-local.yml for HTTPS callback.
GOVBR_CLIENT_ID=65d8b079-bb7a-4158-b1e2-75731bc5f44d
# Prefer the Docker secret .secrets/govbr_client_secret.txt; never commit o segredo real.
# GOVBR_CLIENT_SECRET=
GOVBR_AUTHORIZE_URL=https://hml-prodesp.id.cyberark.cloud/OAuth2/Authorize/apesp_hml
GOVBR_TOKEN_URL=https://hml-prodesp.id.cyberark.cloud/OAuth2/Token/apesp_hml
GOVBR_USERINFO_URL=https://hml-prodesp.id.cyberark.cloud/OAuth2/UserInfo/apesp_hml
GOVBR_AUTHENTICATION_URL=https://hml-prodesp.id.cyberark.cloud/run
GOVBR_APPKEY=65d8b079-bb7a-4158-b1e2-75731bc5f44d
GOVBR_SUFFIX_URLS=apesp_hml
GOVBR_CUSTOMER_ID=abc4967
GOVBR_USERNAME=user@idpsp
GOVBR_JWKS_URL=
GOVBR_REDIRECT_URI=http://10.6.40.57:8000/api/v1/auth/govbr/callback
PUBLIC_APP_URL=https://localhost:8443
CORS_ORIGINS=["https://localhost:8443"]
SESSION_COOKIE_SECURE=true
# Replace locally with a random secret; never use the example in a real deployment.
APP_SESSION_SECRET=change-me-local-session-secret-at-least-32-characters
# Keep a local recovery route while gov.br credentials/callback are being registered.
GOVBR_DEV_LOGIN=true
DEV_ADMIN_ENABLED=true
