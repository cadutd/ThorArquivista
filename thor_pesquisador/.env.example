# Development only. Use docker-compose.govbr-local.yml for HTTPS callback.
GOVBR_CLIENT_ID=change-me
# Prefer the Docker secret .secrets/govbr_client_secret.txt; do not commit it.
# GOVBR_CLIENT_SECRET=
GOVBR_AUTHORIZE_URL=https://sso.staging.acesso.gov.br/authorize
GOVBR_TOKEN_URL=https://sso.staging.acesso.gov.br/token
GOVBR_JWKS_URL=https://sso.staging.acesso.gov.br/jwk
GOVBR_REDIRECT_URI=https://localhost:8443/api/v1/auth/govbr/callback
PUBLIC_APP_URL=https://localhost:8443
CORS_ORIGINS=["https://localhost:8443"]
SESSION_COOKIE_SECURE=true
# Replace locally with a random secret; never use the example in a real deployment.
APP_SESSION_SECRET=change-me-local-session-secret-at-least-32-characters
# Keep a local recovery route while gov.br credentials/callback are being registered.
GOVBR_DEV_LOGIN=true
DEV_ADMIN_ENABLED=true
